PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:3000

# MongoDB Credentials matching docker-compose.yml
MONGO_USER=admin
MONGO_PASSWORD=password123
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=chatapp

# Full MongoDB URI
MONGODB_URI=mongodb://admin:password123@127.0.0.1:27017/chatapp?authSource=admin
